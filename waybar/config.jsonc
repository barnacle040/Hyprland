{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": [
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "cpu",
        "memory",
        "custom/gpu",
        "bluetooth",
        "custom/power"
    ],

    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true,
        "max-length": 80
    },

    "clock": {
        "format": "{:%a %d/%m/%Y  %H:%M:%S}",
        "tooltip-format": "{:%A, %d %B %Y}",
        "interval": 1
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": " {used:0.1f}G",
        "tooltip": false,
        "interval": 2
    },
    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu-usage.sh",
        "format": "󰢮 {}%",
        "interval": 2,
        "tooltip": false
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}  {device_battery_percentage}%",
        "format-connected-battery": " {device_alias}  {device_battery_percentage}%",
        "format-disconnected": " off",
        "tooltip-format": "Bluetooth: {controller_alias}\n{status}",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-right": "rfkill toggle bluetooth"
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip-format": "Power menu"
    }
}
