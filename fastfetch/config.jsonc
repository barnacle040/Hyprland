{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // Uses a smaller, cleaner ASCII logo
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "keys": "magenta",
            "title": "blue"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "󰣇 OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "󰒋 Ker",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "󰏖 Pkg",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "󱆃 Sh",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "󱂬 WM",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "keyColor": "magenta"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "󰍛 Mem",
            "keyColor": "magenta"
        },
        "break",
        "colors"
    ]
}
