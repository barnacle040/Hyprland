{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "auto",
        "padding": {
            "left": 2,
            "right": 2,
            "top": 1
        }
    },

    "display": {
        "separator": " ",
        "color": {
            "keys": "bright_blue",
            "title": "bright_magenta"
        }
    },

    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "  Kernel",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "󰔟  Uptime",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "󰏖  Packages",
            "keyColor": "blue"
        },
        {
            "type": "shell",
            "key": "  Shell",
            "keyColor": "blue"
        },
        {
            "type": "de",
            "key": "󰕮  DE",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "󰒓  WM",
            "keyColor": "blue"
        },
        "separator",
        {
            "type": "cpu",
            "key": "󰍛  CPU",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "󰍹  GPU",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰘚  Memory",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "󰋊  Disk",
            "keyColor": "green"
        },
        "separator",
        "colors"
    ]
}
